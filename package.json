  },
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "menubar",
    "macos",
    "monitor"
  ],
  "type": "module",
  "bin": {
    "usage-bar": "./src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js serve",
